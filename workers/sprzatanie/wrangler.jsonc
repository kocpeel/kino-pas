{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Mały Worker z Cronem: co minutę zwalnia wygasłe rezerwacje i czyści ich dane osobowe
  // (optymalizacja: poprawność zapewnia leniwe wygasanie w zapytaniach aplikacji) oraz wysyła outbox
  // (zwroty i strażnik sesji w Stripe, punkty w Voucherify, maile przez Resend), a raz na dobę anonimizuje kupione bilety
  // DATA_RETENTION_DAYS dni po seansie (retencja RODO) i sprząta inbox, outbox i historię rezerwacji.
  // Sekret STRIPE_SECRET_KEY: `node scripts/cloudflare.mjs wrangler secret put STRIPE_SECRET_KEY --config workers/sprzatanie/wrangler.jsonc`.
  "name": "kasa-kino-sprzatanie",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Tylko Cron, bez handlera fetch: nie wystawiamy adresu *.workers.dev.
  "workers_dev": false,
  "triggers": {
    // Drugi wpis musi być równy CRON_RETENCJI w src/zadania.ts.
    "crons": ["* * * * *", "17 3 * * *"]
  },
  "vars": {
    "DATA_RETENTION_DAYS": "30",
    // Ten sam budżet wywołań Voucherify co w aplikacji (wrangler.jsonc w katalogu głównym).
    "VOUCHERIFY_CALLS_PER_HOUR": "90",
    "VOUCHERIFY_READS_PER_HOUR": "40",
    "LOYALTY_CACHE_SECONDS": "30"
  },
  // Etap III: wspólny licznik wywołań Voucherify to obiekt `LimiterZadan` Workera aplikacji.
  // Sekrety: VOUCHERIFY_APP_ID, VOUCHERIFY_SECRET_KEY, VOUCHERIFY_CAMPAIGN_ID (opcjonalnie VOUCHERIFY_API_URL)
  // i RESEND_API_KEY, każdy przez `wrangler secret put … --config workers/sprzatanie/wrangler.jsonc`.
  "durable_objects": {
    "bindings": [{ "name": "LIMITER", "class_name": "LimiterZadan", "script_name": "kasa-kino" }]
  },
  // Kontrola zdrowia: GET /api/zdrowie głównego Workera co minutę (src/zdrowie.ts).
  // Opcjonalny sekret ALERT_WEBHOOK_URL: `npx wrangler secret put ALERT_WEBHOOK_URL --config workers/sprzatanie/wrangler.jsonc`.
  "services": [{ "binding": "APLIKACJA", "service": "kasa-kino" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kasa-kino-db",
      // Ta sama baza co aplikacja (wrangler.jsonc w katalogu głównym).
      "database_id": "c8b109e6-db72-4b43-bcb8-be3264c1f2e6",
      "migrations_dir": "../../migrations"
    }
  ]
}
