{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Mały Worker z Cronem: zwalnia wygasłe rezerwacje i czyści ich dane osobowe.
  // To tylko optymalizacja: poprawność zapewnia leniwe wygasanie w zapytaniach aplikacji.
  "name": "kasa-kino-sprzatanie",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Tylko Cron, bez handlera fetch: nie wystawiamy adresu *.workers.dev.
  "workers_dev": false,
  "triggers": {
    "crons": ["* * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kasa-kino-db",
      // Ta sama baza co aplikacja (wrangler.jsonc w katalogu głównym).
      "database_id": "c8b109e6-db72-4b43-bcb8-be3264c1f2e6",
      "migrations_dir": "../../migrations"
    }
  ]
}
