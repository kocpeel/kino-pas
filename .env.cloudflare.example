# Skopiuj do .env.cloudflare (poza gitem) i uzupełnij. Czytają go skrypty wdrożeniowe
# (npm run deploy, cron:deploy, db:*:remote) przez scripts/cloudflare.mjs.
# Nie używaj zwykłego .env: Next.js/OpenNext wczytują go do aplikacji i mógłby trafić do wdrożenia.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
