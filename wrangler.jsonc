{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kasa-kino",
  // Własny Worker: OpenNext + kanał WebSocket mapy sali + klasa Durable Objectu (worker.ts).
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // Wymagane przez OpenNext; musi wskazywać na nazwę tego Workera.
    { "binding": "WORKER_SELF_REFERENCE", "service": "kasa-kino" }
  ],
  "observability": { "enabled": true },

  // Jeden Durable Object na seans: trzyma połączenia WebSocket oglądających mapę i rozsyła zmiany.
  "durable_objects": {
    "bindings": [
      { "name": "SALE", "class_name": "SalaSeansu" },
      { "name": "LIMITER", "class_name": "LimiterZadan" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SalaSeansu"] },
    { "tag": "v2", "new_sqlite_classes": ["LimiterZadan"] }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kasa-kino-db",
      // ID bazy z dashboardu Cloudflare (D1 → kasa-kino-db → Database ID).
      // Lokalnie (wrangler/next dev) to samo ID służy tylko jako klucz bazy w .wrangler/state.
      "database_id": "c8b109e6-db72-4b43-bcb8-be3264c1f2e6",
      "migrations_dir": "migrations"
    }
  ],

  // Binding Rate Limiting (zamiast Redisa). namespace_id to dowolna liczba unikalna w obrębie konta.
  // Okres może wynosić tylko 10 albo 60 sekund.
  // Tryb oceny etapu: limitujemy tylko zalew z jednego adresu (50 prób / 10 s), bez limitów na e-mail,
  // żeby testy prowadzącego z jednej maszyny albo z jednym e-mailem nie dostawały 429. Docelowo:
  // IP 10/60 oraz { "name": "RL_REZERWACJE_EMAIL", "namespace_id": "4102", "simple": { "limit": 5, "period": 60 } }.
  "ratelimits": [
    { "name": "RL_REZERWACJE_IP", "namespace_id": "4101", "simple": { "limit": 50, "period": 10 } },
    // Nowe połączenia z kanałem na żywo (WebSocket) z jednego IP.
    { "name": "RL_KANAL_IP", "namespace_id": "4103", "simple": { "limit": 60, "period": 60 } }
  ],

  "vars": {
    // Czas ważności rezerwacji. Tryb testowy do oceny etapu (expiresAt ok. 2 min); docelowo 900 (15 min).
    "RESERVATION_TTL_SECONDS": "120",
    // Ile aktywnych rezerwacji może mieć jeden e-mail naraz (0 = bez limitu).
    // Limity niżej to tryb oceny etapu (zob. ratelimits). Docelowo: 4, 60, 10, 5, 12.
    "MAX_ACTIVE_RESERVATIONS_PER_EMAIL": "0",
    "RATE_LIMIT_PERIOD_SECONDS": "10",
    "RESERVATION_ATTEMPTS_PER_IP": "50",
    "RESERVATION_ATTEMPTS_PER_EMAIL": "0",
    "RESERVATIONS_PER_IP_PER_TTL": "0",
    "EVENTS_CACHE_SECONDS": "5",
    "DB_TIMEOUT_MS": "3000",
    "LOAD_SHED_MAX_READS": "64",
    "LOAD_SHED_MAX_WRITES": "32",
    "LOAD_SHED_DB_LATENCY_TARGET_MS": "800"
  },

  "env": {
    // Środowisko do testów e2e (Playwright): osobna lokalna baza i TTL 5 s.
    // Bindingi i vars nie są dziedziczone przez nazwane środowiska, więc są powtórzone.
    "e2e": {
      "name": "kasa-kino-e2e",
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "kasa-kino-e2e" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kasa-kino-db-e2e",
          "database_id": "00000000-0000-4000-8000-0000000000e2",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        { "name": "RL_REZERWACJE_IP", "namespace_id": "4201", "simple": { "limit": 1000, "period": 60 } },
        { "name": "RL_REZERWACJE_EMAIL", "namespace_id": "4202", "simple": { "limit": 1000, "period": 60 } },
        { "name": "RL_KANAL_IP", "namespace_id": "4203", "simple": { "limit": 1000, "period": 60 } }
      ],
      "vars": {
        "RESERVATION_TTL_SECONDS": "5",
        "MAX_ACTIVE_RESERVATIONS_PER_EMAIL": "4",
        "RATE_LIMIT_PERIOD_SECONDS": "60",
        "RESERVATION_ATTEMPTS_PER_IP": "1000",
        "RESERVATION_ATTEMPTS_PER_EMAIL": "1000",
        "RESERVATIONS_PER_IP_PER_TTL": "0",
        "EVENTS_CACHE_SECONDS": "5",
        "DB_TIMEOUT_MS": "3000",
        "LOAD_SHED_MAX_READS": "64",
        "LOAD_SHED_MAX_WRITES": "32",
        "LOAD_SHED_DB_LATENCY_TARGET_MS": "800"
      }
    },

    // Środowisko testów obciążeniowych w Cloudflare (tests/obciazenie): osobny Worker i osobna baza.
    // Limity rezerwacji na IP/e-mail są wyłączone, żeby test z jednej maszyny mierzył wyścig w bazie
    // i load shedding (ten zostaje jak na produkcji), a nie limiter. Wdrożenie: npm run staging:deploy.
    "staging": {
      "name": "kasa-kino-staging",
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "kasa-kino-staging" }],
      "durable_objects": {
        "bindings": [
          { "name": "SALE", "class_name": "SalaSeansu" },
          { "name": "LIMITER", "class_name": "LimiterZadan" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["SalaSeansu"] },
        { "tag": "v2", "new_sqlite_classes": ["LimiterZadan"] }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kasa-kino-db-staging",
          "database_id": "c7bb330d-60d9-4170-b9f9-5abb55f6444a",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        { "name": "RL_REZERWACJE_IP", "namespace_id": "4301", "simple": { "limit": 100000, "period": 60 } },
        { "name": "RL_REZERWACJE_EMAIL", "namespace_id": "4302", "simple": { "limit": 100000, "period": 60 } },
        { "name": "RL_KANAL_IP", "namespace_id": "4303", "simple": { "limit": 100000, "period": 60 } }
      ],
      "vars": {
        "RESERVATION_TTL_SECONDS": "120",
        "MAX_ACTIVE_RESERVATIONS_PER_EMAIL": "4",
        "RATE_LIMIT_PERIOD_SECONDS": "60",
        "RESERVATION_ATTEMPTS_PER_IP": "0",
        "RESERVATION_ATTEMPTS_PER_EMAIL": "0",
        "RESERVATIONS_PER_IP_PER_TTL": "0",
        "EVENTS_CACHE_SECONDS": "5",
        "DB_TIMEOUT_MS": "3000",
        "LOAD_SHED_MAX_READS": "64",
        "LOAD_SHED_MAX_WRITES": "32",
        "LOAD_SHED_DB_LATENCY_TARGET_MS": "800"
      }
    }
  }
}
